	)
	(text "MIPI D-PHY layout（002 §2.1 / §2.2）"
		(exclude_from_sim no)
		(at 20.32 80.01 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "f5d9619b-d08b-45c4-8439-6e53fa1120a5")
	)
	(text "· 同一對銅線上有兩種訊號：HS 是 200mV 差分、LP 是 1.2V 單端。"
		(exclude_from_sim no)
		(at 25.4 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8cc2c4cf-b198-4187-9ea8-1698f0ae89ba")
	)
	(text "· 所以不能串任何電阻、不能加 AC 耦合電容 —— 那會破壞 LP 的直流準位。"
		(exclude_from_sim no)
		(at 25.4 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "adecd33c-1e69-4887-a018-0a80042e5c83")
	)
	(text "· 100 ohm 差分，對內等長 ±0.1mm，各資料對相對 CK 對 ±0.5mm。"
		(exclude_from_sim no)
		(at 25.4 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "163a8287-4972-4efb-a10e-c70808b1d133")
	)
	(text "· 對與對之間 >= 3x 線寬；全程走完整 GND 平面，不跨分割。"
		(exclude_from_sim no)
		(at 25.4 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d6626f1e-fcb5-47cb-bfaa-742f98b91c45")
	)
