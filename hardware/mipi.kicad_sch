	)
	(text "MIPI D-PHY layout（002 §2.1 / §2.2）"
		(exclude_from_sim no)
		(at 20.32 80.01 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "21a62f93-a144-4909-89de-d43c4e0c4c88")
	)
	(text "· 同一對銅線上有兩種訊號：HS 是 200mV 差分、LP 是 1.2V 單端。"
		(exclude_from_sim no)
		(at 25.4 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c257306b-1bf1-4d33-834d-89bced819038")
	)
	(text "· 所以不能串任何電阻、不能加 AC 耦合電容 —— 那會破壞 LP 的直流準位。"
		(exclude_from_sim no)
		(at 25.4 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "875b269a-044d-497b-9e3e-75135f2ac612")
	)
	(text "· 100 ohm 差分，對內等長 ±0.1mm，各資料對相對 CK 對 ±0.5mm。"
		(exclude_from_sim no)
		(at 25.4 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6a5d503f-8e9e-43c1-a008-f7412961c82d")
	)
	(text "· 對與對之間 >= 3x 線寬；全程走完整 GND 平面，不跨分割。"
		(exclude_from_sim no)
		(at 25.4 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dfedfe7d-f1f0-48e2-84c0-eceba254f252")
	)
