	(text "· 100 ohm 差分，對內等長 ±0.15mm，對 CK 等長 ±0.5mm"
		(exclude_from_sim no)
		(at 25.4 196.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6ab13b06-3779-4393-a953-52568420f354")
	)
	(text "· 1080p60 = 1.485 Gbps/pair，上升時間約 250ps"
		(exclude_from_sim no)
		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ef7dad47-6005-42ec-9b8f-bf81d8ef20d1")
	)
	(text "  -> 臨界長度約 4.7mm，接頭到 U7 全程都要當傳輸線處理"
		(exclude_from_sim no)
		(at 25.4 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "350a203d-7968-46c2-841a-85d30a553a75")
	)
	(text "· 全程走在完整 GND 平面上方，不跨分割"
		(exclude_from_sim no)
		(at 25.4 212.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2daaa644-3b19-4caf-9eab-05b874cb1ad2")
	)
