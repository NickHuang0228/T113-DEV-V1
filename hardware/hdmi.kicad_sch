		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8464bf2a-0e13-4327-b78a-380163cb1e17")
	)
	(text "  -> 臨界長度約 4.7mm，接頭到 U7 全程都要當傳輸線處理"
		(exclude_from_sim no)
		(at 25.4 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3db15f65-230a-4ab0-9a07-1ffbbb7deda6")
	)
	(text "· 全程走在完整 GND 平面上方，不跨分割"
