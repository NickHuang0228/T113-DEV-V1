	)
	(text "· 1080p60 = 1.485 Gbps/pair，上升時間約 250ps"
		(exclude_from_sim no)
		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0d0bfe0-e8b4-42ef-82d3-54edca7fea21")
	)
	(text "  -> 臨界長度約 4.7mm，接頭到 U7 全程都要當傳輸線處理"
		(exclude_from_sim no)
		(at 25.4 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "765035ee-897b-43a3-a66e-c53bab5ec1a6")
	)
	(text "· 全程走在完整 GND 平面上方，不跨分割"
