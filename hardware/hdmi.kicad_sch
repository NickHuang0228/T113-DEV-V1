	)
	(text "· 1080p60 = 1.485 Gbps/pair，上升時間約 250ps"
		(exclude_from_sim no)
		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b3bcb562-6528-4493-b1ab-a21b7614cea6")
	)
	(text "  -> 臨界長度約 4.7mm，接頭到 U7 全程都要當傳輸線處理"
		(exclude_from_sim no)
		(at 25.4 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9de28a71-ffb4-4776-8f80-ff8d55c00d38")
	)
	(text "· 全程走在完整 GND 平面上方，不跨分割"
