	(text "BOOT-SEL（PC4 / PC5 上電瞬間的電平，來源：MangoPi MQ-R 原理圖 p.3）"
		(exclude_from_sim no)
		(at 228.6 227.33 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "f54d4cfd-ba3b-471d-bd63-a74e50c79cc0")
	)
	(text "SEL[1:0]   00: NOR > NAND"
		(exclude_from_sim no)
		(at 228.6 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dc041b2e-d3c0-4c30-90f1-ca0ba852c063")
	)
	(text "           01: SD  > NOR  > Other     <- 本板（有 SD、有 NOR、沒有 NAND）"
		(exclude_from_sim no)
		(at 228.6 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0e3dcf1-f70e-4584-82c0-134dbeb345fc")
	)
	(text "           10: SD  > NAND > Other     <- MangoPi MQ-R 用這個"
		(exclude_from_sim no)
		(at 228.6 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "99d48459-12d0-401f-89e4-3c134117316e")
	)
	(text "           11: SD0 > EMMC2 > EMMC2_USR > Other"
		(exclude_from_sim no)
		(at 228.6 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a67e2168-7bd6-4f0d-9e4a-527916cd9dbf")
	)
	(text "SEL1 = SPI0_MISO (PC5) = 0   -> R66 焊、R65 不焊"
		(exclude_from_sim no)
		(at 228.6 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78c6b7f6-2519-4cec-bf4e-e8118260256b")
	)
	(text "SEL0 = SPI0_MOSI (PC4) = 1   -> R67 焊、R68 不焊"
		(exclude_from_sim no)
		(at 228.6 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9066cdd2-96ea-474c-b976-c5635b6af63e")
	)
	(text "★ 兩個位置都留焊盤：strap 改設定要動焊接，不留位置就得飛線。"
		(exclude_from_sim no)
		(at 228.6 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f84eedf-99b8-470f-809b-b5dc320a546e")
	)
	(text "★ 不需要專用 FEL 腳：SD 與 NOR 都失敗時 BROM 自己落到 USB FEL。"
		(exclude_from_sim no)
		(at 228.6 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5607d1da-f4cf-4d99-8906-5a00a211086a")
	)
	(text "   要強制進 FEL 就把 SEL0 拉低變 00（usb 頁的 SW2）。"
		(exclude_from_sim no)
		(at 228.6 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "18027337-daa6-4044-871b-413231777752")
	)
	(text "⚠ PC4 / PC5 一腳兩用：上電時是 BOOT-SEL，之後才切成 SPI0 的 MOSI/MISO。"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "06ae1e24-c683-4e86-841c-7548324545f5")
	)
	(text "   量測 strap 電平要抓上電那一刻，不是穩態 —— 穩態量到的是 SPI 波形。"
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8048cd7e-5ae4-4b76-996b-2869777ab3de")
	)
	(text "⚠ PF2(SDC0_CLK) / PF4(SDC0_D3) 另有 0Ω 分支到 CH340N 當 UART0 console，"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b112cb8-bf1d-44cb-a6c8-707daab4fec6")
	)
	(text "   見 usb 頁。SD 跑不穩時先拆那兩顆 0Ω 定位（007 §5.2）。"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0d427b8a-522b-4e64-95b7-a36e0daf6367")
	)
