	(text "BOOT-SEL（PC4 / PC5 上電瞬間的電平，來源：MangoPi MQ-R 原理圖 p.3）"
		(exclude_from_sim no)
		(at 228.6 227.33 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "c89030b9-5892-496f-adc5-64b9806f0db3")
	)
	(text "SEL[1:0]   00: NOR > NAND"
		(exclude_from_sim no)
		(at 228.6 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e8f39500-8f65-4dd6-a832-b2358f60df97")
	)
	(text "           01: SD  > NOR  > Other     <- 本板（有 SD、有 NOR、沒有 NAND）"
		(exclude_from_sim no)
		(at 228.6 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "51661beb-acf2-4731-b513-c63a772c53f3")
	)
	(text "           10: SD  > NAND > Other     <- MangoPi MQ-R 用這個"
		(exclude_from_sim no)
		(at 228.6 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "579f39ac-c8a6-40c5-8253-0240e014acdc")
	)
	(text "           11: SD0 > EMMC2 > EMMC2_USR > Other"
		(exclude_from_sim no)
		(at 228.6 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "686f9e6a-ab70-4d15-9688-5cebd4dfe6d0")
	)
	(text "SEL1 = SPI0_MISO (PC5) = 0   -> R66 焊、R65 不焊"
		(exclude_from_sim no)
		(at 228.6 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9304babd-7a93-403e-9863-450ec1392eea")
	)
	(text "SEL0 = SPI0_MOSI (PC4) = 1   -> R67 焊、R68 不焊"
		(exclude_from_sim no)
		(at 228.6 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee894931-2306-4fb7-ae5a-57bcbc414ed6")
	)
	(text "★ 兩個位置都留焊盤：strap 改設定要動焊接，不留位置就得飛線。"
		(exclude_from_sim no)
		(at 228.6 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ccf5576e-4901-4685-b1ea-b6c54fa9d689")
	)
	(text "★ 不需要專用 FEL 腳：SD 與 NOR 都失敗時 BROM 自己落到 USB FEL。"
		(exclude_from_sim no)
		(at 228.6 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e3572a4c-f8fe-4851-807f-2374b054fca6")
	)
	(text "   要強制進 FEL 就把 SEL0 拉低變 00（usb 頁的 SW2）。"
		(exclude_from_sim no)
		(at 228.6 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f69e3ff-44be-4f6d-8f11-576890cc4b73")
	)
	(text "⚠ PC4 / PC5 一腳兩用：上電時是 BOOT-SEL，之後才切成 SPI0 的 MOSI/MISO。"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "d0b2b275-1330-45ff-a036-389431d20091")
	)
	(text "   量測 strap 電平要抓上電那一刻，不是穩態 —— 穩態量到的是 SPI 波形。"
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fdbe92f3-ad5d-4f49-a6c6-4073e748355e")
	)
	(text "⚠ PF2(SDC0_CLK) / PF4(SDC0_D3) 另有 0Ω 分支到 CH340N 當 UART0 console，"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2cfba8ec-dc43-4fe1-98de-9378f0667bff")
	)
	(text "   見 usb 頁。SD 跑不穩時先拆那兩顆 0Ω 定位（007 §5.2）。"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0e03bb5-65bf-44fe-8ec0-358309504914")
	)
