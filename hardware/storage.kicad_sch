	(text "BOOT-SEL（PC4 / PC5 上電瞬間的電平，來源：MangoPi MQ-R 原理圖 p.3）"
		(exclude_from_sim no)
		(at 228.6 227.33 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "6fd521cc-87b5-485f-8787-45f4bd4475f3")
	)
	(text "SEL[1:0]   00: NOR > NAND"
		(exclude_from_sim no)
		(at 228.6 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36495d3c-4a0d-42dc-b5e1-c1da7bf60682")
	)
	(text "           01: SD  > NOR  > Other     <- 本板（有 SD、有 NOR、沒有 NAND）"
		(exclude_from_sim no)
		(at 228.6 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7def4345-5918-46ff-81f3-497621ef6292")
	)
	(text "           10: SD  > NAND > Other     <- MangoPi MQ-R 用這個"
		(exclude_from_sim no)
		(at 228.6 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bede418e-4153-432a-9bf5-8b2936186844")
	)
	(text "           11: SD0 > EMMC2 > EMMC2_USR > Other"
		(exclude_from_sim no)
		(at 228.6 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "64a14186-0557-4653-8d21-bf82e3eab5b7")
	)
	(text "SEL1 = SPI0_MISO (PC5) = 0   -> R66 焊、R65 不焊"
		(exclude_from_sim no)
		(at 228.6 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "85a3e4ad-0248-4025-b621-1c392013dd90")
	)
	(text "SEL0 = SPI0_MOSI (PC4) = 1   -> R67 焊、R68 不焊"
		(exclude_from_sim no)
		(at 228.6 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b026983f-c30a-4ceb-acd2-c743496993da")
	)
	(text "★ 兩個位置都留焊盤：strap 改設定要動焊接，不留位置就得飛線。"
		(exclude_from_sim no)
		(at 228.6 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ae29d65b-27d9-420a-b8e4-b15bbdf58d2c")
	)
	(text "★ 不需要專用 FEL 腳：SD 與 NOR 都失敗時 BROM 自己落到 USB FEL。"
		(exclude_from_sim no)
		(at 228.6 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "833ffb8f-e844-4e72-a430-127b07cb59fc")
	)
	(text "   要強制進 FEL 就把 SEL0 拉低變 00（usb 頁的 SW2）。"
		(exclude_from_sim no)
		(at 228.6 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cccffa45-2186-400d-ba43-8f7f09bad836")
	)
	(text "⚠ PC4 / PC5 一腳兩用：上電時是 BOOT-SEL，之後才切成 SPI0 的 MOSI/MISO。"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "27e2dd4b-3061-4ed4-9fbb-d260c61603b5")
	)
	(text "   量測 strap 電平要抓上電那一刻，不是穩態 —— 穩態量到的是 SPI 波形。"
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a479018-4c34-4fa7-9592-abefe3878b5d")
	)
	(text "⚠ PF2(SDC0_CLK) / PF4(SDC0_D3) 另有 0Ω 分支到 CH340N 當 UART0 console，"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a71fce36-f51c-43c8-b6d8-d0521358c0d7")
	)
	(text "   見 usb 頁。SD 跑不穩時先拆那兩顆 0Ω 定位（007 §5.2）。"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
