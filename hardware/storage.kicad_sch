	(text "BOOT-SEL（PC4 / PC5 上電瞬間的電平，來源：MangoPi MQ-R 原理圖 p.3）"
		(exclude_from_sim no)
		(at 228.6 227.33 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "68e2f6fa-868a-4f2e-9d68-f5035667b5c9")
	)
	(text "SEL[1:0]   00: NOR > NAND"
		(exclude_from_sim no)
		(at 228.6 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f6501a96-0fa1-42df-aa02-51fdfd116d33")
	)
	(text "           01: SD  > NOR  > Other     <- 本板（有 SD、有 NOR、沒有 NAND）"
		(exclude_from_sim no)
		(at 228.6 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "87ffaf16-8390-4f95-b38b-26e799f0cabc")
	)
	(text "           10: SD  > NAND > Other     <- MangoPi MQ-R 用這個"
		(exclude_from_sim no)
		(at 228.6 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fd576263-5d3c-4912-b122-9f2dd163ab52")
	)
	(text "           11: SD0 > EMMC2 > EMMC2_USR > Other"
		(exclude_from_sim no)
		(at 228.6 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "05c83cb9-d106-4145-a52b-42891249c1b8")
	)
	(text "SEL1 = SPI0_MISO (PC5) = 0   -> R66 焊、R65 不焊"
		(exclude_from_sim no)
		(at 228.6 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bbad5a2a-1b38-42ed-aa23-2235f4230e91")
	)
	(text "SEL0 = SPI0_MOSI (PC4) = 1   -> R67 焊、R68 不焊"
		(exclude_from_sim no)
		(at 228.6 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3ac35d5d-d325-4f02-8b62-e4015fee94c4")
	)
	(text "★ 兩個位置都留焊盤：strap 改設定要動焊接，不留位置就得飛線。"
		(exclude_from_sim no)
		(at 228.6 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a5dcf32-f7c4-4d23-9bdd-1492659ad50d")
	)
	(text "★ 不需要專用 FEL 腳：SD 與 NOR 都失敗時 BROM 自己落到 USB FEL。"
		(exclude_from_sim no)
		(at 228.6 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "20ed69f7-d0e0-4e69-b288-eaabe203d9dd")
	)
	(text "   要強制進 FEL 就把 SEL0 拉低變 00（usb 頁的 SW2）。"
		(exclude_from_sim no)
		(at 228.6 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "53b94681-4c70-40e5-ab89-be00865d1ebc")
	)
	(text "⚠ PC4 / PC5 一腳兩用：上電時是 BOOT-SEL，之後才切成 SPI0 的 MOSI/MISO。"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "a470ca4d-1b39-41f7-891a-6663732d78b4")
	)
	(text "   量測 strap 電平要抓上電那一刻，不是穩態 —— 穩態量到的是 SPI 波形。"
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0ea9012-4a81-46c0-8a82-a4bef4186b7e")
	)
	(text "⚠ PF2(SDC0_CLK) / PF4(SDC0_D3) 另有 0Ω 分支到 CH340N 當 UART0 console，"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4c4d5988-b7f4-4bd1-92ff-2e7ce47f7258")
	)
	(text "   見 usb 頁。SD 跑不穩時先拆那兩顆 0Ω 定位（007 §5.2）。"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0c796215-b1ac-4819-91c0-a52dbcdedbd5")
