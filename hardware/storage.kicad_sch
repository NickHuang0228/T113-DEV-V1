	(text "BOOT-SEL（PC4 / PC5 上電瞬間的電平，來源：MangoPi MQ-R 原理圖 p.3）"
		(exclude_from_sim no)
		(at 228.6 227.33 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "c2e52aff-b9c3-4500-b2b9-1cd243494e97")
	)
	(text "SEL[1:0]   00: NOR > NAND"
		(exclude_from_sim no)
		(at 228.6 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "791bb266-3551-4eb4-add4-603839c9080e")
	)
	(text "           01: SD  > NOR  > Other     <- 本板（有 SD、有 NOR、沒有 NAND）"
		(exclude_from_sim no)
		(at 228.6 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fc9fd9d9-1a63-47a4-a135-c0b550d9c06a")
	)
	(text "           10: SD  > NAND > Other     <- MangoPi MQ-R 用這個"
		(exclude_from_sim no)
		(at 228.6 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "902120f9-cf2f-453a-9467-1c811d17bd41")
	)
	(text "           11: SD0 > EMMC2 > EMMC2_USR > Other"
		(exclude_from_sim no)
		(at 228.6 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8946b495-86d6-406a-8ca9-227f0d22a2ce")
	)
	(text "SEL1 = SPI0_MISO (PC5) = 0   -> R66 焊、R65 不焊"
		(exclude_from_sim no)
		(at 228.6 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fc5098cb-95dd-4778-b344-30dead8a9f7e")
	)
	(text "SEL0 = SPI0_MOSI (PC4) = 1   -> R67 焊、R68 不焊"
		(exclude_from_sim no)
		(at 228.6 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "59fd7f4f-56b3-4bca-b2ea-e0b4903b14cf")
	)
	(text "★ 兩個位置都留焊盤：strap 改設定要動焊接，不留位置就得飛線。"
		(exclude_from_sim no)
		(at 228.6 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "233f1214-6349-42fa-9b2f-0ebca0619c7b")
	)
	(text "★ 不需要專用 FEL 腳：SD 與 NOR 都失敗時 BROM 自己落到 USB FEL。"
		(exclude_from_sim no)
		(at 228.6 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cca7dca1-55fb-46b5-8fa1-0f136192a3fa")
	)
	(text "   要強制進 FEL 就把 SEL0 拉低變 00（usb 頁的 SW2）。"
		(exclude_from_sim no)
		(at 228.6 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4d7c9143-ca8a-4215-8f32-ad5b029f8d82")
	)
	(text "⚠ PC4 / PC5 一腳兩用：上電時是 BOOT-SEL，之後才切成 SPI0 的 MOSI/MISO。"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "aa488747-25cc-47cf-b8fb-7a6134874b4e")
	)
	(text "   量測 strap 電平要抓上電那一刻，不是穩態 —— 穩態量到的是 SPI 波形。"
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d202eb3b-7c1e-4e33-b96f-80c55b40633e")
	)
	(text "⚠ PF2(SDC0_CLK) / PF4(SDC0_D3) 另有 0Ω 分支到 CH340N 當 UART0 console，"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a737dd6-b77d-4128-9a05-a48f52499e43")
	)
	(text "   見 usb 頁。SD 跑不穩時先拆那兩顆 0Ω 定位（007 §5.2）。"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "48167492-9f5e-490a-9165-f2ea5b71939d")
